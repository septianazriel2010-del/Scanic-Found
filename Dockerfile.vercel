# syntax=docker/dockerfile:1

# ------------------------------------------------------------------
# Stage 1: Build asset frontend (Tailwind + Vite)
# Kenapa dipisah stage sendiri: image node cuma dipakai buat build,
# nggak ikut kebawa ke image final (yang cuma butuh PHP/FrankenPHP).
# ------------------------------------------------------------------
FROM node:20-alpine AS assets

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install

COPY resources ./resources
COPY vite.config.js tailwind.config.js postcss.config.js ./
RUN npm run build

# ------------------------------------------------------------------
# Stage 2: Base image PHP + FrankenPHP
# ------------------------------------------------------------------
FROM dunglas/frankenphp:1-php8.3-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_pgsql pgsql

WORKDIR /app

# ------------------------------------------------------------------
# Stage 3: Install dependency Composer + siapkan aplikasi
# ------------------------------------------------------------------
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock* ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --optimize-autoloader \
    --prefer-dist

COPY . .

# Timpa/tambahkan hasil build asset dari stage "assets" di atas,
# supaya public/build ikut ada di image final (Tailwind CSS/JS).
COPY --from=assets /app/public/build ./public/build

RUN mkdir -p \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative

# ------------------------------------------------------------------
# Stage 4: Image final yang benar-benar dijalankan Vercel
# ------------------------------------------------------------------
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# Cache & session TIDAK pakai 'array'/'file' di sini karena setiap
# instance Vercel adalah container terpisah (state tidak dibagi).
# Kita override balik pakai 'database' (Supabase) lewat env Vercel,
# tapi kasih default 'array'/'sync' biar image tetap bisa nyala
# standalone kalau env belum di-set.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=array \
    QUEUE_CONNECTION=sync

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
