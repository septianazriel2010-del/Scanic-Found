APP_NAME="SCANIC TRACE"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Database: Supabase (PostgreSQL) ---
# Ambil nilai-nilai ini dari Supabase Dashboard > Project Settings > Database
# > Connection info. Pakai mode "Session pooler" (port 5432) supaya cocok
# dengan koneksi persistent PHP/Laravel biasa (BUKAN "Transaction pooler"
# port 6543, itu untuk environment serverless).
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=
DB_SSLMODE=require

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=public

# --- Supabase Storage (dipakai kalau deploy ke Vercel) ---
# Biarkan kosong untuk development lokal (XAMPP tetap pakai disk 'public'
# di atas). Kalau deploy ke Vercel, set FILESYSTEM_DISK=supabase di
# Vercel Environment Variables, lalu isi variabel di bawah ini juga di
# sana (ambil dari Supabase Dashboard > Project Settings > Storage >
# S3 Connection, setelah bikin bucket baru misalnya bernama "scanic-trace").
# SUPABASE_S3_ACCESS_KEY_ID=
# SUPABASE_S3_SECRET_ACCESS_KEY=
# SUPABASE_S3_REGION=ap-southeast-1
# SUPABASE_S3_BUCKET=scanic-trace
# SUPABASE_S3_ENDPOINT=https://xxxxxxxxxxxx.supabase.co/storage/v1/s3
# SUPABASE_S3_PUBLIC_URL=https://xxxxxxxxxxxx.supabase.co/storage/v1/object/public/scanic-trace

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@scanictrace.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
